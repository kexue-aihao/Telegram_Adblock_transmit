# Create a bot with @BotFather and keep this value secret.
BOT_TOKEN=replace-with-your-bot-token

# Published image used by Docker Compose. Keep :latest for the newest release,
# or pin a version tag such as :v1.0.0 for reproducible deployments.
BOT_IMAGE=ghcr.io/kexue-aihao/telegram-adblock-transmit:latest

# Optional self-hosted Bot API Server endpoint. Keep both %s placeholders:
# first is replaced with the bot token, second with the API method name.
# TELEGRAM_API_ENDPOINT=http://telegram-bot-api:8081/bot%s/%s

# Use a long, URL-safe random password. The Compose file injects it into DATABASE_URL.
POSTGRES_PASSWORD=change-this-password

# Structured log level accepted by the Go service (DEBUG, INFO, WARN, ERROR).
LOG_LEVEL=INFO

# For running the bot outside Compose, set the PostgreSQL DSN explicitly:
# DATABASE_URL=postgres://telegram_bot:change-this-password@localhost:5432/telegram_adblock?sslmode=disable
