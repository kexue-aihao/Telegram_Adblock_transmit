# Caddy reverse proxy for a self-hosted Telegram Bot API Server.
# Replace the domain and upstream name with your deployment values.
telegram-api.example.com {
    # Bot tokens are part of the Bot API request path. Do not write access
    # logs for this site unless a separately verified redaction policy exists.
    log {
        output discard
    }

    reverse_proxy telegram-bot-api:8081 {
        transport http {
            # getUpdates may intentionally wait for Telegram long-poll data.
            response_header_timeout 75s
        }
    }
}

# The moderation bot itself uses long polling and does not expose an HTTP site.
# Do not proxy the bot container as if it were a web application.
