{
  "name": "telegram-adblock-panel",
  "private": true,
  "type": "module",
  "description": "WebUI panel front end. Built assets are committed to internal/webui/assets so the Go build, the Dockerfile and CI need no Node toolchain.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "build:scratch": "vite build --outDir ../.gocache/web-build --emptyOutDir",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
